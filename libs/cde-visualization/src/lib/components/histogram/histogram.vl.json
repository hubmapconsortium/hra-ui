{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "background": {
    "expr": "themeBackground"
  },
  "config": {
    "font": "Nunito Sans Variable",
    "padding": {
      "top": 0,
      "right": 16,
      "bottom": 16,
      "left": 16
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": 400,
      "labelFontWeight": 400,
      "titleLineHeight": 21,
      "labelLineHeight": 21,
      "titleColor": {
        "expr": "themeTitleColor"
      },
      "labelColor": {
        "expr": "themeLabelColor"
      },
      "ticks": false,
      "domain": false,
      "labelPadding": 8,
      "gridColor": {
        "expr": "themeGridColor"
      }
    }
  },
  "data": {
    "name": "data",
    "values": []
  },
  "params": [
    {
      "name": "yAxisTickCount",
      "value": 5
    },
    {
      "name": "colors",
      "value": []
    },
    {
      "name": "themeBackground",
      "value": "#fcfbfd"
    },
    {
      "name": "themeTitleColor",
      "value": "#1a1c1e"
    },
    {
      "name": "themeLabelColor",
      "value": "#414751"
    },
    {
      "name": "themeGridColor",
      "value": "#c1c7d4"
    },
    {
      "name": "themeMarkColor",
      "value": "#1a1c1e"
    }
  ],
  "transform": [
    {
      "calculate": "[datum.type, 'All cells']",
      "as": "type"
    },
    {
      "flatten": ["type"]
    }
  ],
  "mark": {
    "type": "line",
    "interpolate": "step"
  },
  "encoding": {
    "x": {
      "field": "distance",
      "title": "Distance (µm)",
      "bandPosition": 0,
      "bin": {
        "step": 5
      },
      "scale": {
        "domainMin": -5
      },
      "axis": {
        "orient": "top",
        "minExtent": 25,
        "labelFlush": true,
        "grid": true,
        "labelAngle": 0,
        "labelOverlap": true,
        "labelSeparation": 4
      }
    },
    "y": {
      "aggregate": "count",
      "title": "Number of cells",
      "axis": {
        "minExtent": 70,
        "tickCount": {
          "expr": "yAxisTickCount"
        }
      }
    },
    "color": {
      "field": "type",
      "legend": null,
      "scale": {
        "range": [
          {
            "expr": "'Replaced/repeated in javascript' && colors[0] || themeMarkColor"
          }
        ]
      }
    },
    "tooltip": {
      "field": "type",
      "type": "nominal"
    }
  }
}
