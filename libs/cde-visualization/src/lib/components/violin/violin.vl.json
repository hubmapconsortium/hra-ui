{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "spacing": -2,
  "title": {
    "text": "Cell types",
    "anchor": "start",
    "frame": "bounds",
    "orient": "top",
    "offset": -14
  },
  "background": {
    "expr": "themeBackground"
  },
  "config": {
    "font": "Metropolis",
    "padding": {
      "top": 0,
      "right": 16,
      "bottom": 16,
      "left": 16
    },
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "titleFontWeight": 400,
      "labelFontWeight": 400,
      "titleLineHeight": 21,
      "labelLineHeight": 21,
      "titleColor": {
        "expr": "themeTitleColor"
      },
      "labelColor": {
        "expr": "themeLabelColor"
      },
      "ticks": false,
      "labelPadding": 8,
      "gridColor": {
        "expr": "themeGridColor"
      }
    },
    "scale": {
      "continuousPadding": 20
    },
    "title": {
      "fontSize": 14,
      "fontWeight": 400,
      "lineHeight": 21,
      "color": {
        "expr": "themeTitleColor"
      }
    },
    "header": {
      "titleColor": {
        "expr": "themeTitleColor"
      },
      "labelColor": {
        "expr": "themeLabelColor"
      }
    }
  },
  "data": {
    "name": "data",
    "values": []
  },
  "params": [
    {
      "name": "colors",
      "value": []
    },
    {
      "name": "themeBackground",
      "value": "#fcfcfc"
    },
    {
      "name": "themeTitleColor",
      "value": "#201e3d"
    },
    {
      "name": "themeLabelColor",
      "value": "#4b4b5e"
    },
    {
      "name": "themeGridColor",
      "value": "#dddddd"
    },
    {
      "name": "themeMarkColor",
      "value": "#000000"
    }
  ],
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "Count"
        }
      ],
      "groupby": ["type"]
    }
  ],
  "facet": {
    "row": {
      "field": "type",
      "sort": {
        "field": "Count",
        "order": "descending"
      },
      "title": null,
      "header": {
        "labelAngle": 0,
        "labelPadding": 12,
        "labelAlign": "left",
        "labelLimit": 100,
        "labelBaseline": "middle"
      }
    }
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "spec": {
    "height": 35,
    "width": 0,
    "layer": [
      {
        "mark": {
          "type": "area",
          "stroke": {
            "expr": "themeMarkColor"
          },
          "strokeWidth": 0.5
        },
        "transform": [
          {
            "density": "distance",
            "bandwidth": 0,
            "groupby": ["type"]
          }
        ],
        "encoding": {
          "x": {
            "field": "value",
            "type": "quantitative",
            "title": "Distance (µm)",
            "axis": {
              "orient": "top",
              "minExtent": 25,
              "labelFlush": false,
              "grid": true,
              "labelAngle": 0,
              "labelOverlap": true,
              "labelSeparation": 4
            },
            "scale": {
              "domainMin": 0
            }
          },
          "y": {
            "field": "density",
            "type": "quantitative",
            "stack": "center",
            "impute": null,
            "title": null,
            "axis": {
              "labels": false,
              "grid": false
            },
            "scale": {
              "nice": false,
              "padding": 4
            }
          },
          "color": {
            "field": "type",
            "legend": null,
            "scale": {
              "range": [
                {
                  "expr": "'Replaced/repeated in javascript' && colors[0] || themeMarkColor"
                }
              ]
            }
          },
          "tooltip": {
            "field": "type",
            "type": "nominal"
          }
        }
      },
      {
        "mark": {
          "type": "boxplot",
          "extent": "min-max",
          "size": 4,
          "color": "black"
        },
        "encoding": {
          "x": {
            "field": "distance",
            "type": "quantitative",
            "title": "Distance (µm)",
            "scale": {
              "domainMin": 0
            }
          }
        }
      }
    ]
  }
}
