{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Funders",
  "$defs": {
    "Funders": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "funders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Funder"
          }
        }
      },
      "required": [
        "$schema",
        "funders"
      ],
      "additionalProperties": false
    },
    "Funder": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "link": {
          "type": "string",
          "format": "uri"
        },
        "image": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "link",
        "image"
      ],
      "additionalProperties": false
    }
  }
}