{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/HubmapMenu",
  "$defs": {
    "HubmapMenu": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HubmapMenuGroup"
          }
        }
      },
      "required": [
        "$schema",
        "groups"
      ],
      "additionalProperties": false
    },
    "HubmapMenuGroup": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HubmapMenuItem"
          }
        }
      },
      "required": [
        "label",
        "items"
      ],
      "additionalProperties": false
    },
    "HubmapMenuItem": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "label",
        "description",
        "icon",
        "url"
      ],
      "additionalProperties": false
    }
  }
}