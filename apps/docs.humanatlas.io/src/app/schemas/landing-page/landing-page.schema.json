{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/LandingPageData",
  "$defs": {
    "LandingPageData": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "bannerUrl": {
          "type": "string"
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionCard"
          }
        }
      },
      "required": [
        "$schema",
        "tagline",
        "bannerUrl",
        "cards"
      ],
      "additionalProperties": false
    },
    "ActionCard": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "ActionCard"
        },
        "classes": {
          "$ref": "#/$defs/Classes"
        },
        "styles": {
          "$ref": "#/$defs/Styles"
        },
        "controllers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Controller"
          }
        },
        "variant": {
          "$ref": "#/$defs/ActionCardVariant"
        },
        "eyebrow": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "subtagline": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "icons": {
          "$ref": "#/$defs/IconList"
        },
        "content": {
          "$ref": "#/$defs/ProjectedContentTemplate"
        },
        "actionsLeft": {
          "$ref": "#/$defs/ProjectedContentTemplate"
        },
        "actionsRight": {
          "$ref": "#/$defs/ProjectedContentTemplate"
        }
      },
      "required": [
        "component",
        "variant",
        "tagline"
      ],
      "additionalProperties": false
    },
    "Classes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      ]
    },
    "Styles": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      ]
    },
    "Controller": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": {}
    },
    "ActionCardVariant": {
      "type": "string",
      "enum": [
        "elevated",
        "flat",
        "outlined",
        "outlined-with-icons"
      ]
    },
    "IconList": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/IconData"
            }
          ]
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/IconData"
              }
            ]
          }
        }
      ]
    },
    "IconData": {
      "type": "object",
      "properties": {
        "svgIcon": {
          "type": "string"
        },
        "fontIcon": {
          "type": "string"
        },
        "fontSet": {
          "type": "string"
        },
        "inline": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ProjectedContentTemplate": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnyContentTemplate"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnyContentTemplate"
          }
        }
      ]
    },
    "AnyContentTemplate": {
      "$ref": "#/$defs/ContentTemplateWithProps"
    },
    "ContentTemplateWithProps": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string"
        },
        "classes": {
          "$ref": "#/$defs/Classes"
        },
        "styles": {
          "$ref": "#/$defs/Styles"
        },
        "controllers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Controller"
          }
        }
      },
      "required": [
        "component"
      ],
      "additionalProperties": {}
    }
  }
}