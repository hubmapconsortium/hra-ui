{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Organs",
  "$defs": {
    "Organs": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "organs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Organ"
          }
        }
      },
      "required": [
        "$schema",
        "organs"
      ],
      "additionalProperties": false
    },
    "Organ": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "appData": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/ComponentDefId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/OrganAppData"
          }
        }
      },
      "required": [
        "id",
        "label",
        "appData"
      ],
      "additionalProperties": false
    },
    "ComponentDefId": {
      "type": "string"
    },
    "OrganAppData": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  }
}