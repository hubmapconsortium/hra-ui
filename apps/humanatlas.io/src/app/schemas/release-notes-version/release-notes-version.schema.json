{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ReleaseNotesVersions",
  "$defs": {
    "ReleaseNotesVersions": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReleaseNotesVersion"
          }
        }
      },
      "required": [
        "$schema",
        "versions"
      ],
      "additionalProperties": false
    },
    "ReleaseNotesVersion": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "label",
        "date"
      ],
      "additionalProperties": false
    }
  }
}